@@ -15 +16 @@ export function simulationKeeperTarget(simulation, team) {
-  const ball = simulation.ball.position;
+  const ball = keeperThreatPosition(simulation.ball);
@@ -26,0 +28,10 @@ export function simulationKeeperTarget(simulation, team) {
+function keeperThreatPosition(ball) {
+  if (!ball.flight?.cross) return ball.position;
+  const gravity = MATCH_SIM_DATA.ball.gravity;
+  const height = ball.height - MATCH_SIM_DATA.ball.reachableHeight;
+  const discriminant = ball.verticalVelocity ** 2 + 2 * gravity * height;
+  // The first playable descending contact can precede a ground landing on the opposite side.
+  const seconds = discriminant < 0 ? 0 : Math.max(0, (ball.verticalVelocity + Math.sqrt(discriminant)) / gravity);
+  return predictSimulationBall(ball, seconds).position;
+}
