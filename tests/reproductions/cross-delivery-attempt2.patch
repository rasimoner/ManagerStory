+export function arrangeSimulationCross(simulation, restart, targets) {
+  if (restart.delivery?.kind !== 'cross') return;
+  const attack = simulation.teams.find(team => team.id === restart.teamId), defense = simulation.teams.find(team => team.id !== restart.teamId);
+  const runners = attack.players.filter(player => player.slot !== 'GK' && player.id !== restart.takerId && !player.sentOff);
+  runners.sort((left, right) => Number(right.id === restart.delivery.receiverId) - Number(left.id === restart.delivery.receiverId));
+  const selected = runners.slice(0, RESTART_DATA.delivery.runnerPositions.length);
+  selected.forEach((player, index) => {
+    const position = RESTART_DATA.delivery.runnerPositions[index];
+    targets[player.id] = { x: position.x * attack.direction, y: position.y };
+  });
+  assignCrossMarkers(defense.players, selected, { targets, direction: attack.direction });
+}
+
+function assignCrossMarkers(players, runners, { targets, direction }) {
+  const available = players.filter(player => player.slot !== 'GK' && !player.sentOff);
+  for (const runner of runners) {
+    const marker = available.sort((left, right) => pointDistance(left.position, targets[runner.id]) - pointDistance(right.position, targets[runner.id])).shift();
+    if (!marker) break;
+    targets[marker.id] = { x: targets[runner.id].x + direction * RESTART_DATA.delivery.markingDistance, y: targets[runner.id].y };
+  }
+}
