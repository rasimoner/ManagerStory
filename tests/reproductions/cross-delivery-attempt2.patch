diff --git a/src/core/sim/aerial-contact.js b/src/core/sim/aerial-contact.js
new file mode 100644
index 0000000..be5ac0f
--- /dev/null
+++ b/src/core/sim/aerial-contact.js
@@ -0,0 +1,41 @@
+import MATCH_SIM_DATA from '../../data/match-sim.json';
+import RESTART_DATA from '../../data/match-sim-restarts.json';
+import { emitSimulationEvent, settleSimulationPass } from './ball-events.js';
+import { evaluateSimulationShot } from './shot-evaluation.js';
+import { releaseSimulationShot } from './shot-execution.js';
+import { releaseSimulationPass } from './pass-execution.js';
+import { predictSimulationBall } from './ball-physics.js';
+
+export function redirectSimulationAerial(simulation, player, { touching, time }) {
+  if (!simulation.ball.flight?.cross || player.slot === 'GK') return false;
+  const kind = aerialContactKind(player, touching.height);
+  if (!kind) return false;
+  const option = evaluateSimulationShot(simulation, player), settings = RESTART_DATA.aerial;
+  const shot = option.distance <= settings.maximumShotDistance && option.body.turn <= settings.maximumTurn;
+  const flight = simulation.ball.flight, remaining = Math.max(0, simulation.time - time);
+  settleSimulationPass(simulation, { position: touching.position, controlled: true, playerId: player.id, teamId: player.teamId, time });
+  Object.assign(simulation.ball, touching, { flight: null });
+  emitSimulationEvent(simulation, { type: 'aerialContact', time, kind, fromId: player.id, toId: flight.fromId, teamId: player.teamId,
+    fromPos: { ...touching.position }, toPos: { ...touching.position }, height: touching.height, result: shot ? 'shot' : 'clearance' });
+  if (shot) releaseSimulationShot(simulation, player, { ...option, style: kind, contactTime: time,
+    power: option.power * (kind === 'header' ? settings.headPowerFactor : settings.volleyPowerFactor) });
+  else releaseAerialOutlet(simulation, player, { touching, time });
+  Object.assign(simulation.ball, predictSimulationBall(simulation.ball, remaining));
+  return true;
+}
+
+function aerialContactKind(player, height) {
+  const settings = RESTART_DATA.aerial;
+  if (height >= settings.headHeight) return 'header';
+  return height >= settings.volleyMinimumHeight && height <= settings.volleyMaximumHeight && player.attributes.technique >= settings.volleyTechnique ? 'volley' : null;
+}
+
+function releaseAerialOutlet(simulation, player, { touching, time }) {
+  const team = simulation.teams.find(team => team.id === player.teamId);
+  const available = team.players.filter(candidate => candidate.id !== player.id && candidate.slot !== 'GK' && !candidate.sentOff);
+  const receiver = available.sort((left, right) => right.position.x * team.direction - left.position.x * team.direction)[0];
+  if (!receiver) return;
+  const target = { x: Math.max(-MATCH_SIM_DATA.pitch.length / 2, Math.min(MATCH_SIM_DATA.pitch.length / 2,
+    touching.position.x + team.direction * RESTART_DATA.aerial.clearanceDistance)), y: touching.position.y };
+  releaseSimulationPass(simulation, player, { toId: receiver.id, target, lofted: true, startHeight: touching.height, contactTime: time });
+}
diff --git a/src/core/sim/cross-delivery.js b/src/core/sim/cross-delivery.js
new file mode 100644
index 0000000..a36b776
--- /dev/null
+++ b/src/core/sim/cross-delivery.js
@@ -0,0 +1,38 @@
+import MATCH_SIM_DATA from '../../data/match-sim.json';
+import RESTART_DATA from '../../data/match-sim-restarts.json';
+import { emitSimulationEvent } from './ball-events.js';
+
+export function simulationCrossReceiver(simulation, taker) {
+  const team = simulation.teams.find(team => team.id === taker.teamId);
+  return team.players.filter(player => player.id !== taker.id && player.slot !== 'GK' && !player.sentOff)
+    .sort((left, right) => aerialValue(right) - aerialValue(left))[0];
+}
+
+function aerialValue(player) { return player.attributes.firstTouch + player.attributes.technique + player.attributes.strength; }
+
+export function planSimulationCross(simulation, taker) {
+  const receiver = simulationCrossReceiver(simulation, taker), settings = RESTART_DATA.delivery;
+  const skill = (taker.attributes.passing + taker.attributes.technique) / (2 * MATCH_SIM_DATA.attributes.maximum);
+  if (!receiver || skill < settings.minimumSkill) return { kind: 'short' };
+  const direction = simulation.teams.find(team => team.id === taker.teamId).direction;
+  return { kind: 'cross', receiverId: receiver.id, target: { x: direction * settings.targetX, y: settings.targetY } };
+}
+
+export function markSimulationCross(simulation, owner, option) {
+  if (!isSimulationCross(simulation, owner, option)) return;
+  const ball = simulation.ball, settings = RESTART_DATA.delivery;
+  const speed = Math.hypot(ball.velocity.x, ball.velocity.y);
+  const seconds = Math.hypot(option.target.x - ball.position.x, option.target.y - ball.position.y) / speed;
+  ball.verticalVelocity += settings.arrivalHeight / seconds;
+  ball.flight.cross = true;
+  emitSimulationEvent(simulation, { type: 'cross', fromId: owner.id, toId: option.toId, teamId: owner.teamId,
+    fromPos: { ...ball.position }, toPos: { ...option.target }, height: ball.height, restartKind: option.restartKind, success: null });
+}
+
+function isSimulationCross(simulation, owner, option) {
+  if (!option.lofted) return false;
+  if (option.cross) return true;
+  const settings = RESTART_DATA.delivery, direction = simulation.teams.find(team => team.id === owner.teamId).direction;
+  return owner.position.x * direction >= settings.openPlayX && Math.abs(owner.position.y) >= settings.wideY
+    && option.target.x * direction >= settings.minimumTargetX && Math.abs(option.target.y) <= settings.maximumTargetY;
+}
