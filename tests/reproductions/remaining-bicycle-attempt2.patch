index 0000000..3ca3b31
--- /dev/null
+++ b/src/core/presentation/sim/scene-aerial-pose.js
@@ -0,0 +1,22 @@
+import * as THREE from 'three';
+import SIM_VIEW_DATA from '../../../data/match-sim-view.json';
+import { overBackwards } from '../match3d/newview/beats/bicycle-kick.js';
+
+function overheadContact(sample, frame) {
+  return frame.contacts.findLast(event => event.fromId === sample.id && event.type === 'aerialContact'
+    && event.kind === 'bicycle' && event.time <= frame.physicsTime && frame.physicsTime - event.time <= SIM_VIEW_DATA.aerial.overheadSeconds);
+}
+
+export function simulationAerialFlip(sample, frame) {
+  const contact = overheadContact(sample, frame);
+  return contact ? overBackwards(contact.time - SIM_VIEW_DATA.aerial.overheadLeadSeconds, contact.time) : null;
+}
+
+export function poseSimulationAerialFoot(runtime, actor, { sample, frame }) {
+  const contact = overheadContact(sample, frame);
+  if (!contact) return;
+  const elapsed = frame.physicsTime - contact.time, settings = SIM_VIEW_DATA.aerial;
+  if (elapsed > settings.contactSeconds) return;
+  const target = new THREE.Vector3(contact.fromPos.x, contact.height, contact.fromPos.y);
+  runtime.footIK(actor, 'Right', target, 1);
+}
