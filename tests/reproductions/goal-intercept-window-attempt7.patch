diff --git a/src/core/sim/ball-physics.js b/src/core/sim/ball-physics.js
index c3aaa62..9e013e7 100644
--- a/src/core/sim/ball-physics.js
+++ b/src/core/sim/ball-physics.js
@@ -31,0 +32,6 @@ export function simulationBallLandingSeconds(ball) {
+export function simulationBallDescentSeconds(ball, height = MATCH_SIM_DATA.ball.reachableHeight) {
+  const gravity = MATCH_SIM_DATA.ball.gravity;
+  const discriminant = ball.verticalVelocity ** 2 + 2 * gravity * (ball.height - height);
+  return discriminant >= 0 ? (ball.verticalVelocity + sqrt(discriminant)) / gravity : Infinity;
+}
