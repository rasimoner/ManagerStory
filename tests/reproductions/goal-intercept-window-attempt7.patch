@@ -4 +4 @@ import { pointSquaredDistance, clampSimValue } from './geometry.js';
-import { predictSimulationBall } from './ball-physics.js';
+import { predictSimulationBall, simulationBallDescentSeconds } from './ball-physics.js';
@@ -59,0 +60 @@ export function simulationInterceptPlan(player, ball) {
+  const boundary = crossBoundaryInterception(player, ball);
@@ -61,0 +63 @@ export function simulationInterceptPlan(player, ball) {
+    if (boundary && boundary.seconds <= time) return { target: boundary.target, reachable: true };
@@ -72,0 +75,11 @@ export function simulationInterceptPlan(player, ball) {
+function crossBoundaryInterception(player, ball) {
+  if (!ball.flight?.cross) return null;
+  const seconds = Math.max(0, simulationBallDescentSeconds(ball));
+  if (seconds > MATCH_SIM_DATA.passing.chaseHorizonSeconds) return null;
+  const predicted = predictSimulationBall(ball, seconds), pitch = MATCH_SIM_DATA.pitch;
+  if (Math.abs(predicted.position.x) > pitch.length / 2 || Math.abs(predicted.position.y) > pitch.width / 2) return null;
+  const arrival = Math.max(0, simulationPlayerArrival(player, predicted.position) - player.limits.reactionSeconds);
+  if (arrival > seconds) return null;
+  return { target: predicted.position, seconds };
+}
