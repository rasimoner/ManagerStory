{
  "name": "managerstory",
  "version": "7.19.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node tools/lint/lint.js",
    "test": "node tests/run.cjs",
    "test:fast": "node tests/run.cjs --fast",
    "smoke": "node tests/smoke/smoke.mjs && node tests/smoke/lab.mjs && node tests/smoke/lab-legacy-worker.mjs && node tests/smoke/lab-passing.mjs && node tests/smoke/lab-duels.mjs && node tests/smoke/lab-shooting.mjs && node tests/smoke/lab-balance.mjs && node --experimental-vm-modules --disable-warning=ExperimentalWarning tests/smoke/career-sim.mjs",
    "sim:report": "node --experimental-vm-modules --disable-warning=ExperimentalWarning tools/match-sim-report.cjs",
    "sim:career-report": "node --experimental-vm-modules --disable-warning=ExperimentalWarning tools/match-sim-career-report.cjs",
    "sim:duration-report": "node --experimental-vm-modules --disable-warning=ExperimentalWarning tools/match-sim-duration-report.cjs",
    "smoke:sim-3d": "node --experimental-vm-modules --disable-warning=ExperimentalWarning tests/smoke/career-sim-3d.mjs",
    "smoke:keeper-animation": "node --experimental-vm-modules --disable-warning=ExperimentalWarning tests/smoke/keeper-animation.mjs",
    "smoke:remaining-parity": "node --experimental-vm-modules --disable-warning=ExperimentalWarning tests/smoke/remaining-parity.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "^1.64.1",
    "vite": "8.0.13"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
